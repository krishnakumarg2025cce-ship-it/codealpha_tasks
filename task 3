#include<stdio.h>
#define MAX 50

struct Student{
int id;
char name[50];
int age;
float totalMarks;
float percentage;
};

void addStudent(struct Student s[],int n){
int i;
for(i=0;i<n;i++){
printf("\nEnter Student %d ID: ",i+1);
scanf("%d",&s[i].id);
printf("Enter Name: ");
scanf("%s",s[i].name);
printf("Enter Age: ");
scanf("%d",&s[i].age);
do{
printf("Enter Total Marks (0 to 600 only): ");
scanf("%f",&s[i].totalMarks);
}while(s[i].totalMarks<0 || s[i].totalMarks>600);
s[i].percentage=(s[i].totalMarks/600)*100;
}
}

void displayStudents(struct Student s[],int n){
int i;
for(i=0;i<n;i++){
printf("\nStudent %d Details\n",i+1);
printf("ID: %d\n",s[i].id);
printf("Name: %s\n",s[i].name);
printf("Age: %d\n",s[i].age);
printf("Total Marks: %.2f / 600\n",s[i].totalMarks);
printf("Percentage: %.2f%%\n",s[i].percentage);
}
}

int main(){
struct Student students[MAX];
int n;
printf("Enter number of students: ");
scanf("%d",&n);
addStudent(students,n);
displayStudents(students,n);
return 0;
}



